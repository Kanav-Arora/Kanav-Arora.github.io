---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = posts.slice(0, 4);
const topics = [...new Set(recentPosts.flatMap((post) => post.data.tags))].sort();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const dateFormat = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' });
const readTime = (body: string) => Math.max(1, Math.ceil(body.split(/\s+/).filter(Boolean).length / 220));
---

<SiteLayout
	title="Kanav Arora — Technical writing"
	description="Technical writing and notes on software, systems, and the details worth understanding."
>
	<main class="home-shell">
		<section class="intro" aria-labelledby="intro-title">
			<p class="eyebrow"><span class="status-dot"></span> Technical writing by Kanav Arora</p>
			<h1 id="intro-title">Ideas on software,<br class="desktop-break" /> systems &amp; what’s next.</h1>
			<p class="intro-copy">Thoughtful, practical writing about the tools we build and the ideas that make them work.</p>
			<a class="text-link intro-link" href="#writing">Explore the writing <span aria-hidden="true">↓</span></a>
		</section>

		<section class="writing-section" id="writing" aria-labelledby="writing-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow">The archive</p>
					<h2 id="writing-title">Latest writing <span class="post-count">{String(recentPosts.length).padStart(2, '0')}</span></h2>
				</div>
				{topics.length > 0 && (
					<label class="filter-wrap">
						<span class="visually-hidden">Filter posts by topic</span>
						<select id="topic-filter" aria-label="Filter posts by topic">
							<option value="all">All topics</option>
							{topics.map((topic) => <option value={topic}>{topic}</option>)}
						</select>
					</label>
				)}
			</div>

			{posts.length > 0 ? (
				<div class="post-list" id="post-list">
					{recentPosts.map((post, index) => (
						<article class:list={['post-card', { 'post-card-featured': index === 0 }]} data-tags={post.data.tags.join('|')}>
							<a class="post-card-link" href={`${base}posts/${post.id}/`} aria-label={`Read ${post.data.title}`}>
								<div class="post-meta">
									<time datetime={post.data.pubDate.toISOString()}>{dateFormat.format(post.data.pubDate)}</time>
									<span class="meta-separator" aria-hidden="true">·</span>
									<span>{readTime(post.body)} min read</span>
								</div>
								<div class="post-title-row">
									<h3>{post.data.title}</h3>
									<span class="arrow" aria-hidden="true">↗</span>
								</div>
								<p class="post-description">{post.data.description}</p>
								<div class="tag-list" aria-label="Topics">
									{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
								</div>
							</a>
						</article>
					))}
				</div>
				<a class="archive-link" href={`${base}writing/`}>Browse all {posts.length} articles <span aria-hidden="true">→</span></a>
				<p class="empty-state" id="empty-state" hidden>No writing found for this topic yet.</p>
			) : (
				<div class="empty-archive">
					<p>Your first post is one Markdown file away.</p>
					<span>Add a <code>.md</code> file in <code>src/content/blog/</code> to get started.</span>
				</div>
			)}
		</section>

		<section class="about-strip" aria-label="About Kanav">
			<div class="about-mark" aria-hidden="true">K.</div>
			<div>
				<p class="eyebrow">About Kanav</p>
				<p>I write about software, technology, and ideas worth understanding deeply.</p>
			</div>
			<a class="text-link" href={`${base}about/`}>More about me <span aria-hidden="true">↗</span></a>
		</section>
	</main>

	<script>
		const topicFilter = document.querySelector<HTMLSelectElement>('#topic-filter');
		const postCards = [...document.querySelectorAll<HTMLElement>('.post-card')];
		const emptyState = document.querySelector<HTMLElement>('#empty-state');

		topicFilter?.addEventListener('change', () => {
			const selectedTopic = topicFilter.value;
			let visiblePosts = 0;

			for (const card of postCards) {
				const tags = card.dataset.tags?.split('|') ?? [];
				const isVisible = selectedTopic === 'all' || tags.includes(selectedTopic);
				card.hidden = !isVisible;
				if (isVisible) visiblePosts += 1;
			}

			if (emptyState) emptyState.hidden = visiblePosts > 0;
		});
	</script>
</SiteLayout>
