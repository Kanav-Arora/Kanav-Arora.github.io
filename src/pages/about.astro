---
import SiteLayout from '../layouts/SiteLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<SiteLayout
	title="About Kanav Arora"
	description="Kanav Arora is a data scientist on Deloitte’s Global Data Science team, interested in building AI products and learning new things."
>
	<main class="about-page-shell">
		<a class="back-link" href={`${base}`}><span aria-hidden="true">←</span> Home</a>
		<section class="about-hero" aria-labelledby="about-title">
			<div class="portrait-frame">
				<img class="portrait-image" src={`${base}profile.jpeg`} alt="Kanav Arora" />
				<div class="portrait-overlay"><span>KANAV ARORA</span></div>
			</div>
			<div class="about-intro">
				<p class="eyebrow"><span class="status-dot"></span> A little introduction</p>
				<h1 id="about-title">Hello, I’m Kanav<span class="title-period">.</span></h1>
				<p class="about-lede">I’m a data scientist on Deloitte’s Global Data Science team, passionate about building AI products.</p>
				<p class="about-body">I’m curious about how data and emerging technologies can solve real problems. This site is where I share what I’m learning across data science, AI, and software—and explore new ideas along the way.</p>
				<div class="about-socials">
					<a class="text-link" href="https://www.linkedin.com/in/kanavarora1505/" target="_blank" rel="noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span></a>
					<a class="text-link" href="https://github.com/Kanav-Arora" target="_blank" rel="noreferrer">Explore my GitHub <span aria-hidden="true">↗</span></a>
				</div>
			</div>
		</section>

		<section class="about-details" aria-label="About Kanav’s work and interests">
			<article class="about-detail-card">
				<span class="detail-number">01</span>
				<h2>What I work on</h2>
				<p>Data science and AI products that turn useful ideas into practical solutions.</p>
			</article>
			<article class="about-detail-card">
				<span class="detail-number">02</span>
				<h2>How I approach it</h2>
				<p>Stay curious, keep learning, and work through problems with evidence and experimentation.</p>
			</article>
			<article class="about-detail-card">
				<span class="detail-number">03</span>
				<h2>What I’m exploring</h2>
				<p>New ideas across AI, software, and technology—and how to make them useful.</p>
			</article>
		</section>

		<section class="about-footer-cta">
			<div>
				<p class="eyebrow">Keep exploring</p>
				<h2>There’s more to read.</h2>
			</div>
			<a class="text-link" href={`${base}writing/`}>Browse all writing <span aria-hidden="true">→</span></a>
		</section>
	</main>
</SiteLayout>