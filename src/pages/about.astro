---
import SiteLayout from '../layouts/SiteLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<SiteLayout
	title="About Kanav Arora"
	description="About Kanav Arora and the ideas behind this technical writing site."
>
	<main class="about-page-shell">
		<a class="back-link" href={`${base}`}><span aria-hidden="true">←</span> Home</a>
		<section class="about-hero" aria-labelledby="about-title">
			<div class="portrait-frame">
				<img class="portrait-image" src={`${base}profile.jpg`} alt="Kanav Arora" />
				<div class="portrait-overlay"><span>KANAV ARORA</span></div>
			</div>
			<div class="about-intro">
				<p class="eyebrow"><span class="status-dot"></span> A little introduction</p>
				<h1 id="about-title">Hello, I’m Kanav<span class="title-period">.</span></h1>
				<p class="about-lede">I write about software, technology, and the ideas that make the digital world work.</p>
				<p class="about-body">This site is where I share technical explorations and clear explanations of things I’ve found worth understanding. The goal is simple: make complex ideas feel a little more approachable, one article at a time.</p>
				<div class="about-socials">
					<a class="text-link" href="https://www.linkedin.com/in/kanavarora1505/" target="_blank" rel="noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span></a>
					<a class="text-link" href="https://github.com/Kanav-Arora" target="_blank" rel="noreferrer">Explore my GitHub <span aria-hidden="true">↗</span></a>
				</div>
			</div>
		</section>

		<section class="about-details" aria-label="About the writing">
			<article class="about-detail-card">
				<span class="detail-number">01</span>
				<h2>What I write about</h2>
				<p>Software engineering, useful tools, systems, and the details behind the technology we use every day.</p>
			</article>
			<article class="about-detail-card">
				<span class="detail-number">02</span>
				<h2>How I approach it</h2>
				<p>Start with curiosity, follow the evidence, and explain the important parts without unnecessary complexity.</p>
			</article>
			<article class="about-detail-card">
				<span class="detail-number">03</span>
				<h2>Why this site exists</h2>
				<p>A home for longer-form technical writing—built to keep the focus on ideas and the people reading them.</p>
			</article>
		</section>

		<section class="about-footer-cta">
			<div>
				<p class="eyebrow">Keep exploring</p>
				<h2>There’s more to read.</h2>
			</div>
			<a class="text-link" href={`${base}writing/`}>Browse all writing <span aria-hidden="true">→</span></a>
		</section>
	</main>
</SiteLayout>