---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f7f7f5" id="theme-color" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" href={`${base}favicon.png?v=20261106`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
		<title>{title}</title>
		<script is:inline>
			try {
				const savedTheme = localStorage.getItem('kanav-blog-theme');
				const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				if (savedTheme === 'dark' || (!savedTheme && systemPrefersDark)) {
					document.documentElement.dataset.theme = 'dark';
					document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#111216');
				}
			} catch {}
		</script>
	</head>
	<body>
		<header class="site-header">
			<div class="header-inner">
				<a class="brand" href={base} aria-label="Kanav Arora home">
					<span class="brand-mark">K<span>.</span></span>
					<span class="brand-name">Kanav Arora</span>
				</a>
				<nav class="main-nav" aria-label="Main navigation">
					<a href={`${base}writing/`}>Read</a>
					<a href={`${base}about/`}>About</a>
				</nav>
				<div class="header-actions">
					<a class="social-link" href="https://www.linkedin.com/in/kanavarora1505/" target="_blank" rel="noreferrer" aria-label="LinkedIn profile">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.2 8.5H2.1V22h3.1V8.5ZM3.65 2A1.8 1.8 0 1 0 3.7 5.6 1.8 1.8 0 0 0 3.65 2ZM22 13.9c0-4.1-2.2-6-5.2-6a4.5 4.5 0 0 0-4 2.2V8.5H9.7V22h3.1v-6.7c0-1.8.35-3.6 2.6-3.6s2.3 2.1 2.3 3.7V22H22v-8.1Z" /></svg>
					</a>
					<a class="social-link" href="https://github.com/Kanav-Arora" target="_blank" rel="noreferrer" aria-label="GitHub profile">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.5 21.6c.55.1.76-.24.76-.53v-2.04c-3.1.68-3.76-1.32-3.76-1.32-.5-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.15 1.72 1.15 1 1.72 2.62 1.22 3.26.94.1-.73.39-1.22.71-1.5-2.47-.28-5.07-1.24-5.07-5.5 0-1.22.44-2.21 1.15-2.99-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.11-1.44 3.05-1.14 3.05-1.14.61 1.54.23 2.68.11 2.96.72.78 1.15 1.77 1.15 2.99 0 4.27-2.6 5.21-5.08 5.49.4.35.76 1.02.76 2.06v3.06c0 .29.2.63.77.52A11.1 11.1 0 0 0 12 .9Z" /></svg>
					</a>
					<button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme" title="Switch theme">
						<svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.8" /><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" /></svg>
						<svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8 8.6 8.6 0 1 0 20.2 15.1Z" /></svg>
					</button>
				</div>
			</div>
		</header>
		<slot />
		<footer class="site-footer">
			<div class="footer-inner">
				<p>© {new Date().getFullYear()} Kanav Arora</p>
				<p>Made for the curious <span aria-hidden="true">·</span> Set in Markdown</p>
			</div>
		</footer>
		<script>
			const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
			const themeColor = document.querySelector<HTMLMetaElement>('#theme-color');
			themeToggle?.addEventListener('click', () => {
				const isDark = document.documentElement.dataset.theme === 'dark';
				const nextTheme = isDark ? 'light' : 'dark';
				document.documentElement.dataset.theme = nextTheme;
				if (themeColor) themeColor.content = isDark ? '#f7f7f5' : '#111216';
				themeToggle.setAttribute('aria-label', `Switch to ${isDark ? 'dark' : 'light'} theme`);
				try {
					localStorage.setItem('kanav-blog-theme', nextTheme);
				} catch {}
			});
		</script>
	</body>
</html>